<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/roleLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ruolo: SLAVE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/becomeMasterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diventa Master"
            android:textSize="12sp"
            android:visibility="visible" />

        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="#4CAF50" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FF0000" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/localIpTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indirizzo Locale: -"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/remoteIpTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indirizzo Remoto: -"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="#000"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/focusControlLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusLayout"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/remoteImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <androidx.camera.view.PreviewView
            android:id="@+id/localPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/focusControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cameraContainer"
        app:layout_constraintBottom_toTopOf="@id/statusTextView">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AF"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autofocusSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

        <SeekBar
            android:id="@+id/focusSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="In attesa..."
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/focusControlLayout" />

    <LinearLayout
        android:id="@+id/bottomActionsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nuova Scansione -->
        <ImageButton
            android:id="@+id/scanButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_button_background"
            android:src="@android:drawable/ic_menu_rotate"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Nuova Scansione"
            app:tint="#FFFFFF" />

        <!-- Scatta Foto (Capture) -->
        <ImageButton
            android:id="@+id/captureButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_red_button_background"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Scatta Foto"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <!-- Modifica Foto -->
        <ImageButton
            android:id="@+id/editPhotoButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_button_background"
            android:src="@android:drawable/ic_menu_edit"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Modifica foto"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <!-- Carica Foto -->
        <ImageButton
            android:id="@+id/loadPhotoButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/circle_button_background"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Carica Foto"
            android:visibility="gone"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Full Screen Color & Tool Palette Container (Slave View) -->
    <FrameLayout
        android:id="@+id/slavePaletteContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF1E1E1E"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Strumenti &amp; Colori Disegno"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/paletteBadgeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PALETTE ASSEGNATA: STRUMENTI"
                android:textColor="#2196F3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#332196F3"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/paletteBadgeDescTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispositivo dedicato per la palette assegnata"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp" />

            <!-- TABS CAMBIO PALETTE (1, 2, 3) -->
            <LinearLayout
                android:id="@+id/paletteTabsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/tabPalette1Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="1. Strumenti"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tabPalette2Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="2. Colori"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tabPalette3Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="3. Sfumature"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- SEZIONE 1: PALETTE STRUMENTI -->
                    <LinearLayout
                        android:id="@+id/paletteToolsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Palette Strumenti"
                            android:textColor="#2196F3"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#2A2A2A"
                            android:padding="16dp"
                            android:layout_marginBottom="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Dimensione Pennello"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/brushSizeValueTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 px"
                                    android:textColor="#2196F3"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="12dp">

                                <View
                                    android:id="@+id/brushSizePreviewView"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/circle_button_background"
                                    android:layout_marginEnd="12dp" />

                                <SeekBar
                                    android:id="@+id/brushSizeSeekBar"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:min="2"
                                    android:max="80"
                                    android:progress="12" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- SEZIONE 2: PALETTE COLORI -->
                    <LinearLayout
                        android:id="@+id/paletteColorsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Palette Colori"
                            android:textColor="#2196F3"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/colorPaletteLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginBottom="20dp" />
                    </LinearLayout>

                    <!-- SEZIONE 3: PALETTE COLOR SCHEME & SFUMATURE -->
                    <LinearLayout
                        android:id="@+id/paletteShadesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Palette Color Scheme &amp; Sfumature"
                            android:textColor="#2196F3"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                        android:id="@+id/customShadePaletteLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#2A2A2A"
                        android:padding="16dp"
                        android:layout_marginBottom="20dp">

                        <!-- ANTEPRIMA SFUMATURA ATTUALE -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <View
                                android:id="@+id/customShadePreview"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_button_background"
                                android:layout_marginEnd="14dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/customShadeNameTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sfumatura Attiva"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/customShadeHexTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="#FF0000"
                                    android:textColor="#2196F3"
                                    android:textSize="13sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/applyCustomShadeButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Applica"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- SLIDER TONALITA (HUE) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tonalità (Spettro Cromatico)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <com.igino.remote_camera.ColorSliderView
                            android:id="@+id/hueSliderView"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp" />

                        <!-- SLIDER SFUMATURA / LUMINOSITA -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sfumatura (Scuro - Vivo - Chiaro)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <com.igino.remote_camera.ColorSliderView
                            android:id="@+id/shadeSliderView"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp" />

                        <!-- SLIDER SATURAZIONE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Intensità / Saturazione (Tenue - Vivace)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <com.igino.remote_camera.ColorSliderView
                            android:id="@+id/saturationSliderView"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginBottom="16dp" />

                        <!-- SFUMATURE GENERATE DEL COLOR SCHEME -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sfumature del Color Scheme (Tinte &amp; Ombre)"
                            android:textColor="#2196F3"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:id="@+id/generatedShadesContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical" />
                        </HorizontalScrollView>

                        <!-- ARMONIE CROMATICHE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Armonie Cromatiche (Complementare, Analoghe)"
                            android:textColor="#2196F3"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/colorHarmoniesContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/backToDrawingButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Torna al Disegno"
                    android:textSize="15sp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/closePaletteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chiudi Modifica"
                    android:textSize="15sp"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Full Screen Drawing Container (Master View) -->
    <FrameLayout
        android:id="@+id/fullScreenDrawingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <com.igino.remote_camera.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#80000000"
            android:gravity="center_vertical">

            <View
                android:id="@+id/drawingColorIndicator"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#FF0000"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/drawingStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disegna con il dito"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/clearDrawingButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancella"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/saveDrawingButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salva"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/closeDrawingButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>